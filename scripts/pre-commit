#!/bin/sh
# またね：公開前のチェック（.git/hooks/pre-commit にコピーして使う。scripts/install-hooks.sh）
#  ① アプリのファイルを変えたのに src/config.js の APP_VERSION が上がっていなければ止める
#     （上がっていないと、開きっぱなしの相手の端末が自動で新しい版に切り替わらない）
#  ② version.json を APP_VERSION と同じ番号に自動でそろえる（相手の端末はこれを見て更新する）
ver=$(grep -o "APP_VERSION = '[0-9.]*'" src/config.js | grep -o "[0-9][0-9.]*")
[ -z "$ver" ] && { echo "pre-commit: APP_VERSION が見つかりません"; exit 1; }
if git diff --cached --name-only | grep -qE '^(src/|index.html|styles.css|sw.js|manifest.json|icons/)'; then
  old=$(git show HEAD:src/config.js 2>/dev/null | grep -o "APP_VERSION = '[0-9.]*'" | grep -o "[0-9][0-9.]*")
  if [ "$ver" = "$old" ]; then
    echo "pre-commit: アプリを変えたので src/config.js の APP_VERSION を上げてください（今 $ver）"
    exit 1
  fi
fi
printf '{ "version": "%s" }\n' "$ver" > version.json
git add version.json
